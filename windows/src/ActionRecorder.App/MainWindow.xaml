<Window x:Class="ActionRecorder.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ActionRecorder.Desktop"
        Title="Action Recorder" Width="1280" Height="820" MinWidth="1100" MinHeight="700"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar"/>
    </Window.TaskbarItemInfo>
    <Grid>
        <!-- main shell -->
        <Grid x:Name="Shell">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="16,18,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,18">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Action Recorder" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Click="OnNewMacro" IsEnabled="{Binding CanEdit}"
                                HorizontalContentAlignment="Left" ToolTip="Create an empty macro">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" Margin="0,0,8,0"/>
                                <TextBlock Text="New macro"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="OnImport" Margin="8,0,0,0" ToolTip="Import a .macro.json file (also from the Mac app)">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="MacroList" Style="{StaticResource SoftList}" ItemsSource="{Binding Recordings}"
                                 SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="12,9" Background="Transparent">
                                        <StackPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Rename" Click="OnRenameEntry"/>
                                                <MenuItem Header="Duplicate" Click="OnDuplicateEntry"/>
                                                <MenuItem Header="Export…" Click="OnExportEntry"/>
                                                <Separator/>
                                                <MenuItem Header="Delete" Click="OnDeleteEntry"/>
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12"
                                    Visibility="{Binding Recordings.Count, Converter={StaticResource EmptyToVis}}">
                            <TextBlock Text="No macros yet" Style="{StaticResource HeadingText}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Press Record, do something in another program, then press Stop." Style="{StaticResource MutedText}"
                                       TextAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="0,0,0,10" ToolTip="Stops recording and playback instantly, from any program.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Emergency stop" Style="{StaticResource MutedText}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding EmergencyStopText}" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource GhostButton}" Click="OnOpenSettings" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" Margin="0,0,10,0"/>
                                <TextBlock Text="Settings"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- main area -->
            <Grid Grid.Column="1" Margin="26,20,26,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- update banner -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}"
                        Padding="14,10" Margin="0,0,0,14" Visibility="{Binding ShowUpdateBanner, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding UpdateText}" VerticalAlignment="Center" Style="{StaticResource BodyText}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Download" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="OnDownloadUpdate"
                                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Restart to update" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="OnInstallUpdate"
                                    Visibility="{Binding UpdateReady, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- header -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="MacroTitle" Text="{Binding CurrentName}" Style="{StaticResource TitleText}" TextTrimming="CharacterEllipsis"
                                       MaxWidth="560" ToolTip="Double-click to rename" Cursor="IBeam"
                                       Visibility="{Binding HasRecording, Converter={StaticResource BoolToVis}}" MouseLeftButtonDown="OnTitleClick"/>
                            <TextBlock Text="No macro selected" Style="{StaticResource TitleText}"
                                       Visibility="{Binding HasRecording, Converter={StaticResource InvBoolToVis}}"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE70F;" Margin="6,0,0,0" ToolTip="Rename" Click="OnRenameCurrent"
                                    Visibility="{Binding HasRecording, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding CanEdit}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasRecording, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource MutedText}">
                                <Run Text="{Binding ActionCount, Mode=OneWay}"/><Run Text=" actions"/>
                                <Run Text="  ·  "/><Run Text="{Binding DurationText, Mode=OneWay}"/>
                                <Run Text="  ·  Target: "/><Run Text="{Binding TargetText, Mode=OneWay}"/>
                            </TextBlock>
                            <Border Style="{StaticResource Chip}" Background="{DynamicResource WarnSoftBrush}" Margin="10,-3,0,-3" Padding="8,2"
                                    Visibility="{Binding FromMac, Converter={StaticResource BoolToVis}}" ToolTip="Recorded with the Mac app. Keys were converted when it was imported.">
                                <TextBlock Text="From Mac" Foreground="{DynamicResource WarnBrush}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- status chip -->
                    <Border Grid.Column="1" x:Name="StatusChip" CornerRadius="16" Padding="14,7" VerticalAlignment="Top" MinWidth="110">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Recording">
                                        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Playing">
                                        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Paused">
                                        <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Preparing">
                                        <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource MutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Recording">
                                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Playing">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                <Setter Property="Fill" Value="{DynamicResource WarnBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Preparing">
                                                <Setter Property="Fill" Value="{DynamicResource WarnBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Error">
                                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- transport + options -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button x:Name="RecordButton" Style="{StaticResource DangerButton}" Click="OnRecord" Margin="0,0,10,0"
                                        IsEnabled="{Binding CanRecord}"
                                        Visibility="{Binding IsRecordingOrPreparing, Converter={StaticResource InvBoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="11" Height="11" Fill="White" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Record"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="StopRecordButton" Style="{StaticResource DangerButton}" Click="OnStopRecording" Margin="0,0,10,0"
                                        Visibility="{Binding IsRecordingOrPreparing, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="11" Height="11" Background="White" CornerRadius="2" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Stop recording"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PlayButton" Style="{StaticResource SuccessButton}" Click="OnPlay" Margin="0,0,10,0"
                                        IsEnabled="{Binding CanPlay}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" Margin="0,0,9,0"/>
                                        <TextBlock Text="Play"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PauseButton" Style="{StaticResource SecondaryButton}" Click="OnPause" Margin="0,0,10,0"
                                        IsEnabled="{Binding CanPause}" Visibility="{Binding CanResume, Converter={StaticResource InvBoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE769;" Margin="0,0,9,0"/>
                                        <TextBlock Text="Pause"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ResumeButton" Style="{StaticResource SecondaryButton}" Click="OnResume" Margin="0,0,10,0"
                                        Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" Margin="0,0,9,0"/>
                                        <TextBlock Text="Resume"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RestartButton" Style="{StaticResource SecondaryButton}" Click="OnRestart" Margin="0,0,10,0"
                                        IsEnabled="{Binding IsPlayingOrPaused}" ToolTip="Start again from the first action">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" Margin="0,0,9,0"/>
                                        <TextBlock Text="Restart"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="EmergencyButton" Style="{StaticResource SecondaryButton}" Click="OnEmergencyStop" IsEnabled="{Binding CanStop}"
                                    Foreground="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBrush}"
                                    ToolTip="Stops recording and playback at once">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE71A;" Margin="0,0,9,0"/>
                                    <TextBlock Text="Emergency stop"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- progress while playing -->
                        <Grid Margin="0,14,0,0" Visibility="{Binding IsPlayingOrPaused, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="{Binding PlaybackText}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" Margin="0,0,140,0"/>
                                <TextBlock Text="{Binding RepetitionText}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar Grid.Row="1" Minimum="0" Maximum="1" Value="{Binding PlaybackFraction, Mode=OneWay}" Height="6"
                                         Foreground="{DynamicResource SuccessBrush}" Background="{DynamicResource Surface2Brush}" BorderThickness="0"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,16,0,14"/>

                        <!-- playback options -->
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,28,8">
                                <TextBlock Text="Speed" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel x:Name="SpeedPills" Orientation="Horizontal"/>
                                    <Slider x:Name="SpeedSlider" Width="130" Minimum="-4.32" Maximum="4.32" VerticalAlignment="Center" Margin="8,0,10,0"
                                            IsMoveToPointEnabled="True" ValueChanged="OnSpeedSliderChanged" ToolTip="Drag for a custom speed"/>
                                    <TextBox x:Name="SpeedBox" Width="62" Padding="6,5" VerticalContentAlignment="Center" LostFocus="OnSpeedBoxCommit" KeyDown="OnSpeedBoxKey"
                                             ToolTip="Type a custom speed, for example 3 or 0.75"/>
                                    <TextBlock Text="×" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,28,8">
                                <TextBlock Text="Repeat" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="56" Padding="6,5" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                             Text="{Binding RepeatCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             IsEnabled="{Binding Infinite, Converter={StaticResource InvBool}}"/>
                                    <TextBlock Text="times" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,14,0"/>
                                    <CheckBox Content="Until stopped" IsChecked="{Binding Infinite, Mode=TwoWay}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,28,8">
                                <TextBlock Text="Pause between runs" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="56" Padding="6,5" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                             Text="{Binding LoopDelay, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.##}"/>
                                    <TextBlock Text="seconds" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,28,8">
                                <TextBlock Text="Countdown" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="56" Padding="6,5" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                             Text="{Binding Countdown, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Text="seconds" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                        <Grid Margin="0,2,0,0">
                            <CheckBox Content="Only play while the recorded program is in front" IsChecked="{Binding VerifyForeground, Mode=TwoWay}"
                                      ToolTip="Stops playback with an error if another program has focus. Needs a recorded target program."/>
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}" Text="{Binding EstimateText}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- actions + side panel -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,12,14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Actions" Style="{StaticResource HeadingText}" VerticalAlignment="Center" Margin="2,0,12,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE7A7;" ToolTip="Undo (Ctrl+Z)" Command="{Binding UndoCommand}"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE7A6;" ToolTip="Redo (Ctrl+Y)" Command="{Binding RedoCommand}"/>
                                    <Border Width="1" Background="{DynamicResource LineBrush}" Margin="6,6"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE121;" ToolTip="Add a wait after the selected action" Click="OnAddWait" IsEnabled="{Binding CanEdit}"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE765;" ToolTip="Insert a Discord keyboard preset" Click="OnPresets" IsEnabled="{Binding CanEdit}"/>
                                    <Border Width="1" Background="{DynamicResource LineBrush}" Margin="6,6"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Duplicate selected" Click="OnDuplicateActions" IsEnabled="{Binding CanEdit}"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74A;" ToolTip="Move up" Click="OnMoveUp" IsEnabled="{Binding CanEdit}"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74B;" ToolTip="Move down" Click="OnMoveDown" IsEnabled="{Binding CanEdit}"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete selected (Del)" Click="OnDeleteActions" IsEnabled="{Binding CanEdit}"/>
                                    <Border Width="1" Background="{DynamicResource LineBrush}" Margin="6,6"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE890;" ToolTip="Show where the clicks will land" Click="OnShowClicks" IsEnabled="{Binding HasActions}"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Play only the selected actions" Click="OnPlaySelection" IsEnabled="{Binding CanPlay}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <ListBox x:Name="ActionList" Style="{StaticResource SoftList}" ItemsSource="{Binding Rows}" SelectionMode="Extended"
                                         SelectionChanged="OnActionSelectionChanged" KeyDown="OnActionListKey"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="10,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="Opacity" Value="0.55"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <TextBlock Grid.Column="0" Text="{Binding Number}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Glyph}" Foreground="{DynamicResource AccentBrush}" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="Normal"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="3" Text="{Binding DelayText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasActions, Converter={StaticResource InvBoolToVis}}">
                                    <TextBlock Text="No actions yet" Style="{StaticResource HeadingText}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Press Record and use another program, or add steps with the buttons above." Style="{StaticResource MutedText}"
                                               TextAlignment="Center" Margin="0,6,0,0" MaxWidth="320"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="4,4,4,4">
                        <TabControl x:Name="SideTabs" BorderThickness="0" Background="Transparent">
                            <TabItem Header="Details">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                                    <ContentControl x:Name="InspectorHost"/>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Check">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Reliability check" Style="{StaticResource HeadingText}"/>
                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,10"
                                                   Text="Fixed rules that spot common problems. They run on this PC only."/>
                                        <TextBlock Text="Nothing to flag." Style="{StaticResource BodyText}" Foreground="{DynamicResource SuccessBrush}"
                                                   Visibility="{Binding HasFindings, Converter={StaticResource InvBoolToVis}}"/>
                                        <ItemsControl ItemsSource="{Binding Findings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Card}" Background="{DynamicResource Surface2Brush}" Padding="12,10" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                                            <Button Content="{Binding FixLabel}" Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="0,8,0,0"
                                                                    HorizontalAlignment="Left" Click="OnApplyFix" Tag="{Binding}"
                                                                    Visibility="{Binding FixLabel, Converter={StaticResource HasValueToVis}}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,8,0,14"/>
                                        <TextBlock Text="Improve this macro" Style="{StaticResource HeadingText}"/>
                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,10"
                                                   Text="Suggests removing needless mouse movement and merging typing. You choose what to apply, and you can undo it."/>
                                        <Button Content="Find improvements" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="OnPlanImprovements"
                                                IsEnabled="{Binding CanEdit}"/>
                                        <ItemsControl ItemsSource="{Binding Proposals}" Margin="0,10,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Card}" Background="{DynamicResource Surface2Brush}" Padding="12,10" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" MaxWidth="250"/>
                                                            </CheckBox>
                                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource MutedText}" Margin="26,2,0,0"/>
                                                            <TextBlock Text="{Binding SourceText}" Style="{StaticResource MutedText}" FontSize="11" Margin="26,4,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="Apply selected" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="OnApplyProposals"
                                                Visibility="{Binding HasProposals, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding CanEdit}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="AI helper">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Local AI helper" Style="{StaticResource HeadingText}"/>
                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,10"
                                                   Text="Runs on this PC through Ollama. Nothing is sent to the internet. Its advice can be wrong, so you always review it first."/>

                                        <Border Style="{StaticResource Card}" Background="{DynamicResource Surface2Brush}" Padding="12,10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding AiMessage}" Style="{StaticResource BodyText}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Button Content="Check again" Style="{StaticResource SecondaryButton}" Padding="12,5" Click="OnAiRefresh" Margin="0,0,8,0"/>
                                                    <Button Content="Get Ollama" Style="{StaticResource SecondaryButton}" Padding="12,5" Click="OnGetOllama" Margin="0,0,8,0"
                                                            Visibility="{Binding AiNeedsOllama, Converter={StaticResource BoolToVis}}"/>
                                                    <Button Content="Download model" Style="{StaticResource PrimaryButton}" Padding="12,5" Click="OnPullModel"
                                                            Visibility="{Binding AiNeedsModel, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                                           Visibility="{Binding AiNeedsModel, Converter={StaticResource BoolToVis}}">
                                                    <Run Text="Downloads "/><Run Text="{Binding RecommendedModel, Mode=OneWay}"/><Run Text=" ("/><Run Text="{Binding RecommendedModelSize, Mode=OneWay}"/><Run Text=") once."/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <Grid Margin="0,0,0,10" Visibility="{Binding AiBusy, Converter={StaticResource BoolToVis}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{Binding AiBusyText}" Style="{StaticResource BodyText}"/>
                                            <ProgressBar Grid.Row="1" Height="6" Margin="0,6,0,6" Minimum="0" Maximum="1" Value="{Binding AiPullFraction, Mode=OneWay, TargetNullValue=0}"
                                                         IsIndeterminate="{Binding AiPullFraction, Mode=OneWay, Converter={StaticResource NullToTrue}}"
                                                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource Surface2Brush}" BorderThickness="0"/>
                                            <Button Grid.Row="2" Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="12,5" HorizontalAlignment="Left" Click="OnAiCancel"/>
                                        </Grid>

                                        <StackPanel IsEnabled="{Binding AiReady}">
                                            <TextBlock Text="On this macro" Style="{StaticResource FieldLabel}"/>
                                            <WrapPanel>
                                                <Button Content="Review" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,8" Click="OnAiReview"
                                                        IsEnabled="{Binding HasActions}"/>
                                                <Button Content="Suggest edits" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,8" Click="OnAiEdits"
                                                        IsEnabled="{Binding HasActions}"/>
                                                <Button Content="Suggest a name" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,8" Click="OnAiName"
                                                        IsEnabled="{Binding HasActions}"/>
                                            </WrapPanel>

                                            <Border Style="{StaticResource Card}" Background="{DynamicResource Surface2Brush}" Padding="12,10" Margin="0,0,0,10"
                                                    Visibility="{Binding SuggestedName, Converter={StaticResource HasValueToVis}}">
                                                <StackPanel>
                                                    <TextBlock Text="Suggested name" Style="{StaticResource MutedText}"/>
                                                    <TextBlock Text="{Binding SuggestedName}" FontWeight="SemiBold" Margin="0,2,0,8" TextWrapping="Wrap"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Use this name" Style="{StaticResource PrimaryButton}" Padding="12,5" Click="OnAcceptName" Margin="0,0,8,0"/>
                                                        <Button Content="Dismiss" Style="{StaticResource SecondaryButton}" Padding="12,5" Click="OnDismissName"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource Card}" Background="{DynamicResource Surface2Brush}" Padding="12,10" Margin="0,0,0,10"
                                                    Visibility="{Binding HasAiReview, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <TextBlock Text="Review" Style="{StaticResource MutedText}"/>
                                                    <TextBox Text="{Binding AiReview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                                             Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="Describe steps to add" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="DraftBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" Padding="8" MaxLength="400"
                                                     ToolTip="For example: open the general channel and say good morning"/>
                                            <Button Content="Draft steps" Style="{StaticResource SecondaryButton}" Padding="12,6" HorizontalAlignment="Left" Margin="0,8,0,8" Click="OnAiDraft"
                                                    IsEnabled="{Binding CanEdit}"/>
                                            <Border Style="{StaticResource Card}" Background="{DynamicResource Surface2Brush}" Padding="12,10"
                                                    Visibility="{Binding HasDraft, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <TextBlock Text="Preview. Nothing is added until you insert it." Style="{StaticResource MutedText}"/>
                                                    <ItemsControl x:Name="DraftList" Margin="0,6,0,8"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Insert after selection" Style="{StaticResource PrimaryButton}" Padding="12,5" Click="OnInsertDraft" Margin="0,0,8,0"/>
                                                        <Button Content="Discard" Style="{StaticResource SecondaryButton}" Padding="12,5" Click="OnDiscardDraft"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- toast -->
        <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,28" MaxWidth="720" CornerRadius="12" Padding="16,12"
                BorderThickness="1" Visibility="{Binding Notice, Converter={StaticResource HasValueToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NoticeKind}" Value="Success">
                            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NoticeKind}" Value="Warning">
                            <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NoticeKind}" Value="Error">
                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Notice}" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" Width="28" Height="28" Margin="12,-4,-6,-4" Click="OnDismissNotice" ToolTip="Dismiss"/>
            </Grid>
        </Border>

        <!-- welcome -->
        <local:WelcomeView x:Name="Welcome" Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</Window>
