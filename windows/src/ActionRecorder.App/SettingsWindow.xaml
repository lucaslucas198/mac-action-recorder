<Window x:Class="ActionRecorder.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="900" Height="680" MinWidth="780" MinHeight="560"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="12,18,12,12">
                    <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="8,0,0,16"/>
                    <ListBox x:Name="Nav" Style="{StaticResource SoftList}" SelectedIndex="0" SelectionChanged="OnNavChanged">
                        <ListBoxItem><TextBlock Text="Recording" Margin="12,8"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="Playback" Margin="12,8"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="Storage" Margin="12,8"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="AI helper" Margin="12,8"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="Updates" Margin="12,8"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="Appearance" Margin="12,8"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="Privacy and access" Margin="12,8"/></ListBoxItem>
                        <ListBoxItem><TextBlock Text="About" Margin="12,8"/></ListBoxItem>
                    </ListBox>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <!-- Recording -->
                <ScrollViewer x:Name="PageRecording" VerticalScrollBarVisibility="Auto" Padding="30,24">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="Recording" Style="{StaticResource TitleText}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,18" Text="What gets captured between Record and Stop."/>
                        <CheckBox Content="Record mouse movement" IsChecked="{Binding Recording.IncludeMouseMove}" Margin="0,0,0,10"/>
                        <CheckBox Content="Record scrolling" IsChecked="{Binding Recording.RecordScroll}" Margin="0,0,0,10"/>
                        <CheckBox Content="Record keyboard shortcuts (such as Ctrl+K)" IsChecked="{Binding Recording.RecordShortcuts}" Margin="0,0,0,10"/>
                        <CheckBox Content="Record typed text" IsChecked="{Binding Recording.RecordText}" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="26,0,0,14" Text="Turn this off if you only want clicks and shortcuts, so passwords can never end up in a macro."/>
                        <CheckBox Content="Minimize this window while recording" IsChecked="{Binding HideWindowWhileRecording}" Margin="0,0,0,10"/>

                        <TextBlock Text="Countdown before recording starts (seconds)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Width="90" HorizontalAlignment="Left" Padding="8,6" Text="{Binding RecordingCountdown}"/>
                        <TextBlock Text="Mouse movement precision" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="90" Padding="8,6" Text="{Binding Recording.MinMoveDistance, StringFormat=0.##}"/>
                            <TextBlock Text="pixels minimum between recorded moves" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBox Width="90" Padding="8,6" Text="{Binding Recording.MinEventInterval, StringFormat=0.###}"/>
                            <TextBlock Text="seconds minimum between recorded moves" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" Text="Larger values make smaller files and smoother, simpler playback."/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Playback -->
                <ScrollViewer x:Name="PagePlayback" VerticalScrollBarVisibility="Auto" Padding="30,24" Visibility="Collapsed">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="Playback" Style="{StaticResource TitleText}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,18" Text="Defaults for new macros. Each macro remembers its own speed and repeat settings."/>
                        <TextBlock Text="Default speed" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="90" Padding="8,6" Text="{Binding DefaultSpeed, StringFormat=0.##}"/>
                            <TextBlock Text="× (1 = the speed you recorded at)" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Default repeats" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="90" Padding="8,6" Text="{Binding DefaultRepeatCount}"/>
                            <TextBlock Text="times (0 = until stopped)" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Default pause between runs (seconds)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Width="90" HorizontalAlignment="Left" Padding="8,6" Text="{Binding DefaultLoopDelay, StringFormat=0.##}"/>
                        <TextBlock Text="Countdown before playback (seconds)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Width="90" HorizontalAlignment="Left" Padding="8,6" Text="{Binding PlaybackCountdown}"/>

                        <TextBlock Text="Reliability" Style="{StaticResource HeadingText}" Margin="0,22,0,0"/>
                        <TextBlock Text="Shortest wait between steps when playing faster than 1× (seconds)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Width="90" HorizontalAlignment="Left" Padding="8,6" Text="{Binding MinActionDelay, StringFormat=0.###}"/>
                        <TextBlock Text="Time between typed characters at 1× (seconds)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Width="90" HorizontalAlignment="Left" Padding="8,6" Text="{Binding TypingCharDelay, StringFormat=0.###}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" Text="Raise these if a program drops keys or misses clicks at high speed."/>

                        <TextBlock Text="Safety" Style="{StaticResource HeadingText}" Margin="0,22,0,10"/>
                        <CheckBox Content="Ask before every playback" IsChecked="{Binding ConfirmBeforePlay}" Margin="0,0,0,10"/>
                        <CheckBox Content="Only play while the recorded program is in front" IsChecked="{Binding VerifyForeground}" Margin="0,0,0,10"/>
                        <CheckBox Content="Minimize this window while playing" IsChecked="{Binding HideWindowDuringPlayback}" Margin="0,0,0,10"/>

                        <TextBlock Text="Emergency stop shortcut" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="HotKeyBox" Width="240" HorizontalAlignment="Left" Padding="8,6" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 PreviewKeyDown="OnHotKeyKey" GotKeyboardFocus="OnHotKeyFocus" LostKeyboardFocus="OnHotKeyBlur"/>
                        <TextBlock x:Name="HotKeyHint" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                   Text="Click the box, then press the shortcut you want. It needs Ctrl, Alt, Shift or Win. It works in every program."/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Storage -->
                <ScrollViewer x:Name="PageStorage" VerticalScrollBarVisibility="Auto" Padding="30,24" Visibility="Collapsed">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="Storage" Style="{StaticResource TitleText}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,18" Text="Where macros and backups live. Leave a box empty to use the default."/>
                        <CheckBox Content="Save changes automatically" IsChecked="{Binding AutoSave}" Margin="0,0,0,10"/>

                        <TextBlock Text="Macro folder" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="SaveFolderBox" Padding="8,6" Text="{Binding SaveDirectoryPath}"/>
                            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,6" Click="OnBrowseSave"/>
                        </Grid>
                        <TextBlock x:Name="SaveFolderDefault" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>

                        <TextBlock Text="Import and export folder" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ExportFolderBox" Padding="8,6" Text="{Binding ExportDirectoryPath}"/>
                            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,6" Click="OnBrowseExport"/>
                        </Grid>

                        <TextBlock Text="Backups" Style="{StaticResource HeadingText}" Margin="0,24,0,10"/>
                        <CheckBox Content="Back up my macros each time the app starts" IsChecked="{Binding BackupEnabled}" Margin="0,0,0,6"/>
                        <TextBlock Text="Backups to keep" Style="{StaticResource FieldLabel}"/>
                        <TextBox Width="90" HorizontalAlignment="Left" Padding="8,6" Text="{Binding BackupKeepCount}"/>
                        <TextBlock Text="Backup folder" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="BackupFolderBox" Padding="8,6" Text="{Binding BackupDirectoryPath}"/>
                            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,6" Click="OnBrowseBackup"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Back up now" Style="{StaticResource SecondaryButton}" Click="OnBackupNow" Margin="0,0,8,0"/>
                            <Button Content="Open macro folder" Style="{StaticResource SecondaryButton}" Click="OnOpenFolder"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- AI -->
                <ScrollViewer x:Name="PageAi" VerticalScrollBarVisibility="Auto" Padding="30,24" Visibility="Collapsed">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="AI helper" Style="{StaticResource TitleText}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,18"
                                   Text="Optional. Uses a language model running on this PC through Ollama. Macro text is never sent to the internet, and the address must stay on this computer."/>
                        <CheckBox Content="Turn the AI helper on" IsChecked="{Binding AiEnabled}" Margin="0,0,0,10"/>
                        <TextBlock Text="Ollama address" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="AiEndpointBox" Padding="8,6" Text="{Binding AiEndpoint}"/>
                        <TextBlock x:Name="AiEndpointHint" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                   Text="Default: http://127.0.0.1:11434. Only this computer (127.0.0.1, localhost or ::1) is accepted."/>
                        <TextBlock Text="Model (leave empty to choose automatically)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Padding="8,6" Text="{Binding AiModel}"/>
                        <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="14,12">
                            <StackPanel>
                                <TextBlock x:Name="AiStatusText" Style="{StaticResource BodyText}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Check again" Style="{StaticResource SecondaryButton}" Click="OnAiCheck" Margin="0,0,8,0"/>
                                    <Button Content="Get Ollama" Style="{StaticResource SecondaryButton}" Click="OnGetOllama" Margin="0,0,8,0"/>
                                    <Button Content="Download model" Style="{StaticResource SecondaryButton}" Click="OnPullModel"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Updates -->
                <ScrollViewer x:Name="PageUpdates" VerticalScrollBarVisibility="Auto" Padding="30,24" Visibility="Collapsed">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="Updates" Style="{StaticResource TitleText}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,18"
                                   Text="The only internet use besides the optional AI helper: one read-only request to this app's GitHub releases page."/>
                        <CheckBox Content="Check for updates when the app starts" IsChecked="{Binding CheckForUpdates}" Margin="0,0,0,10"/>
                        <CheckBox Content="Download new versions in the background" IsChecked="{Binding AutoDownloadUpdates}" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="26,0,0,16"
                                   Text="A download is checked against its published SHA-256 value, and nothing is installed until you press Restart to update."/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Check now" Style="{StaticResource SecondaryButton}" Click="OnCheckUpdates"/>
                            <TextBlock x:Name="UpdateStatus" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Appearance -->
                <ScrollViewer x:Name="PageAppearance" VerticalScrollBarVisibility="Auto" Padding="30,24" Visibility="Collapsed">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="Appearance" Style="{StaticResource TitleText}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,18" Text="Applied right away. Cancel puts it back."/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ThemeDark" Content="Dark" GroupName="theme" Style="{StaticResource PillRadio}" Click="OnThemeChoice"/>
                            <RadioButton x:Name="ThemeLight" Content="Light" GroupName="theme" Style="{StaticResource PillRadio}" Click="OnThemeChoice"/>
                            <RadioButton x:Name="ThemeSystem" Content="Same as Windows" GroupName="theme" Style="{StaticResource PillRadio}" Click="OnThemeChoice"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Privacy -->
                <ScrollViewer x:Name="PagePrivacy" VerticalScrollBarVisibility="Auto" Padding="30,24" Visibility="Collapsed">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="Privacy and access" Style="{StaticResource TitleText}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,18"
                                   Text="Windows does not ask for special permission to record or replay input, but it does limit what a normal app can control."/>

                        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="This PC right now" Style="{StaticResource HeadingText}"/>
                                <TextBlock x:Name="AccessText" Style="{StaticResource BodyText}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="What this app records" Style="{StaticResource HeadingText}" Margin="0,8,0,6"/>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,12" Text="Only between Record and Stop: mouse position, clicks, scrolling, key presses and typed text. While recording, a pill at the top of the screen is always visible. Nothing is recorded in the background."/>
                        <TextBlock Text="Where it goes" Style="{StaticResource HeadingText}" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,12" Text="Macros are saved as readable files on this PC, and nowhere else unless you export them. The app never uploads recordings."/>
                        <TextBlock Text="Passwords" Style="{StaticResource HeadingText}" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,12" Text="Anything you type while recording is stored as text. Don't type passwords or other secrets while recording, or turn off “Record typed text”."/>
                        <TextBlock Text="Programs running as administrator" Style="{StaticResource HeadingText}" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,18" Text="Windows blocks a normal app from sending input to, or seeing input in, a program that runs as administrator. If recording or playback does nothing in such a program, start Action Recorder as administrator too."/>

                        <Button Content="Delete all my macros…" Style="{StaticResource SecondaryButton}" Foreground="{DynamicResource DangerBrush}"
                                BorderBrush="{DynamicResource DangerBrush}" HorizontalAlignment="Left" Click="OnDeleteAll"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- About -->
                <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" Padding="30,24" Visibility="Collapsed">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="About" Style="{StaticResource TitleText}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Image Source="pack://application:,,,/Assets/logo.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Action Recorder for Windows" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AboutVersion" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="AboutSystem" Style="{StaticResource MutedText}" Margin="0,18,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button Content="Open on GitHub" Style="{StaticResource SecondaryButton}" Click="OnOpenGitHub" Margin="0,0,8,0"/>
                            <Button Content="Show the welcome screen again" Style="{StaticResource SecondaryButton}" Click="OnShowWelcome"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,22,0,0"
                                   Text="Coordinate-based playback can fail when a window moves, the screen resolution changes, or a program's layout changes. Check a macro after changing your setup."/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,260,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="OnCancel" Margin="0,0,8,0" IsCancel="True"/>
                    <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="OnSave" IsDefault="True" Padding="26,9"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
