<UserControl x:Class="ActionRecorder.Desktop.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource BgBrush}">
        <!-- Home page -->
        <Grid x:Name="HomePage">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640">
                <Image Source="pack://application:,,,/Assets/logo.png" Width="104" Height="104" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Action Recorder" FontSize="38" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                <TextBlock Text="Record what you do on this PC, then play it back as often and as fast as you like."
                           Style="{StaticResource MutedText}" FontSize="16" TextAlignment="Center" Margin="0,10,0,34"/>
                <UniformGrid Columns="3" Margin="0,0,0,38">
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7C8;" FontSize="22" Foreground="{DynamicResource DangerBrush}"/>
                            <TextBlock Text="Record" FontWeight="SemiBold" Margin="0,10,0,4"/>
                            <TextBlock Text="Clicks, typing, shortcuts and scrolling, in any program such as Discord." Style="{StaticResource MutedText}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70F;" FontSize="22" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Edit" FontWeight="SemiBold" Margin="0,10,0,4"/>
                            <TextBlock Text="Fix a delay, change a click position or rewrite the text. Undo anything." Style="{StaticResource MutedText}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" FontSize="22" Foreground="{DynamicResource SuccessBrush}"/>
                            <TextBlock Text="Play" FontWeight="SemiBold" Margin="0,10,0,4"/>
                            <TextBlock Text="From 0.25× to 5× speed, repeated or looped, with an emergency stop." Style="{StaticResource MutedText}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Button Content="Get started" Style="{StaticResource PrimaryButton}" Padding="40,13" FontSize="15" HorizontalAlignment="Center"
                        Click="OnGetStarted"/>
                <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,22,0,0"
                           Text="Your macros stay on this PC. Nothing is uploaded."/>
            </StackPanel>
        </Grid>

        <!-- Setup page -->
        <Grid x:Name="SetupPage" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="560">
                <TextBlock Text="Checking this PC" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="This takes a moment and changes nothing on your computer." Style="{StaticResource MutedText}" FontSize="14" Margin="0,6,0,26"/>

                <ProgressBar x:Name="SetupBar" Minimum="0" Maximum="1" Height="8" BorderThickness="0"
                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource Surface2Brush}"/>
                <Grid Margin="0,8,0,22">
                    <TextBlock Text="{Binding SetupTitle}" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="{Binding SetupStep}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding SetupChecks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Symbol}" FontSize="18" FontWeight="Bold" VerticalAlignment="Top">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Ok">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Warning">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Working">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,2,0,0"
                                                   Visibility="{Binding Detail, Converter={StaticResource HasValueToVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                           Visibility="{Binding SetupHasWarnings, Converter={StaticResource BoolToVis}}"
                           Text="Items marked ! will not stop the app from opening. Details are in Settings."/>

                <Button Content="Enter" Style="{StaticResource PrimaryButton}" Padding="44,12" FontSize="15" HorizontalAlignment="Center" Margin="0,24,0,0"
                        IsEnabled="{Binding SetupDone}" Click="OnEnter"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
